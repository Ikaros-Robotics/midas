        <xacro:unless value="$(arg sim_mode)">
            <ros2_control name="real_robot" type="system">
                <hardware>
                    <plugin>midas_interface/MidasInterface</plugin>
                    <param name="J1">J1</param>
                    <param name="J2">J2</param>
                    <param name="J3">J3</param>
                    <param name="J4">J4</param>
                    <param name="J5">J5</param>
                </hardware>
                <joint name="J1">
                    <command_interface name="position">
                        <param name="min">-360</param>
                        <param name="max">360</param>
